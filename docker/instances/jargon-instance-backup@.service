# Backs up instance %i and verifies the backup. jargon-instance-backup@%i.timer starts it. `setup`
# replaces /opt/jargon-docker/instances/ with the folder of jargon-instance.
[Unit]
Description=Back up Jargon instance %i
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/jargon-docker/instances/jargon-instance backup %i --verify
TimeoutStartSec=6h
