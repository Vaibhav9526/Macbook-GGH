# The app of instance %i asks for an update with an empty file in update-requests.
# `jargon-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of Jargon instance %i

[Path]
PathExists=/srv/jargon/%i/update-requests/update-stage
PathExists=/srv/jargon/%i/update-requests/update-install

[Install]
WantedBy=paths.target
