#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/Jargon/HostManager'
"$ROOT/jargon-host" --verify-installation
# Payload files have explicit root:wheel modes. Never recurse through tenant status or homes.
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.jargon.host-manager.plist
fi
echo 'Jargon Host installed. Run sudo jargon-host setup, then sudo jargon-host verify.'
