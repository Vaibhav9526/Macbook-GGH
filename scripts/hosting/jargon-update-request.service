# Stages the newest release, or stops Jargon, moves the staged release into place and starts Jargon
# again, when an owner, an admin or a permitted member asks for it in Server Settings > Updates.
[Unit]
Description=Update Jargon on request
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/Jargon/hosted/jargon-hosted-update request
# A download and an apply: the limits of jargon-update.service and jargon-update-apply.service.
TimeoutStartSec=45min
