#!/bin/bash
# jargon.service runs this as the sandbox user. It waits for the env file that jargon-hosted-env
# writes, starts a D-Bus session with an unlocked keyring so that Electron `safeStorage` can keep
# the account session, and runs Jargon on a virtual display. The agents work on the boat desktop.
#
# On a self-hosted server (`mode` is `self`, which jargon-server-setup writes) there is no claim and
# no boat desktop: Jargon starts with `JARGON_SERVER=1` on a virtual display, the agents work on a
# second one, and its owner signs it in with `jargon login`.
set -euo pipefail
umask 077

# ExecStop of jargon.service. The unit also holds the virtual displays, and its stop signal goes to
# each of its processes at the same time. An Xvfb that stops first ends Jargon before it closes its
# database. So this gives the signal to Jargon only and waits for it; the unit then stops the rest.
if [ "${1:-}" = --stop ]; then
  pid=$(cat "$XDG_RUNTIME_DIR/jargon.pid" 2>/dev/null) || exit 0
  [[ $pid =~ ^[1-9][0-9]*$ && /proc/$pid/exe -ef /opt/Jargon/app/jargon ]] || exit 0
  kill -TERM "$pid" 2>/dev/null || exit 0
  while [ -e "/proc/$pid" ]; do sleep 0.2; done
  exit 0
fi
state="$HOME/.config/jargon-hosted"
mode=hosted
if [ -r /opt/Jargon/hosted/mode ] && [ "$(</opt/Jargon/hosted/mode)" = self ]; then mode=self; fi

if [ "${1:-}" != --in-session ] && [ "$mode" = self ]; then
  mkdir -p "$state"
  chmod 0700 "$state"
  exec dbus-run-session -- "$0" --in-session
fi
if [ "${1:-}" != --in-session ]; then
  # The setup script starts after the sandbox is ready, so on the first boot this runs first.
  for _ in $(seq 1 300); do
    [ -s "$state/env" ] && break
    sleep 2
  done
  [ -s "$state/env" ] || { echo "The hosted server env file is missing." >&2; exit 1; }
  exec dbus-run-session -- "$0" --in-session
fi

# Read only the expected keys. The file is data, not a script.
if [ "$mode" = hosted ]; then
  while IFS='=' read -r key value; do
    case $key in
      JARGON_HOSTED_HOST_ID | JARGON_HOSTED_CLAIM) export "$key=$value" ;;
    esac
  done <"$state/env"
  export JARGON_HOSTED_SERVER=1
else
  # The control socket of `jargon`. It goes in the runtime directory that jargon.service makes.
  export JARGON_SERVER=1
fi
# A self-hosted server has this file only when its install named another account server or a
# display size.
requested_size=""
if [ -r /opt/Jargon/hosted/jargon.env ]; then
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case $key in
      JARGON_AUTH_API_URL) export "$key=$value" ;;
      JARGON_DISPLAY_SIZE) requested_size=$value ;;
    esac
  done </opt/Jargon/hosted/jargon.env
fi

# The size of the virtual display, which computer use reads: $1 as WIDTHxHEIGHT, else 1280x800. A
# value that is not valid writes a warning and does not stop the start. See
# docs/self-hosted-server.md#display-size. jargon-container has the same rules.
display_size() {
  if [[ $1 =~ ^([1-9][0-9]{2,3})x([1-9][0-9]{2,3})$ ]] &&
    [ "${BASH_REMATCH[1]}" -ge 640 ] && [ "${BASH_REMATCH[1]}" -le 2576 ] &&
    [ "${BASH_REMATCH[2]}" -ge 480 ] && [ "${BASH_REMATCH[2]}" -le 2576 ]; then
    echo "$1"
    return
  fi
  [ -z "$1" ] || echo "JARGON_DISPLAY_SIZE is not WIDTHxHEIGHT from 640x480 to 2576x2576. The display is 1280x800." >&2
  echo 1280x800
}

# Each server makes its own keyring password on its first start, so no two servers share one.
# The password only lets the daemon open the keyring without a person; the file is 0600.
# A keyring with no password file is not new: a new password cannot open it, so the service stops
# and systemd tries again after the home folder is back.
if [ ! -s "$state/keyring-password" ] && [ -e /srv/jargon-hosted/keyrings/login.keyring ]; then
  echo "The keyring exists, but its password file is missing." >&2
  exit 1
fi
if [ ! -s "$state/keyring-password" ]; then
  temporary=$(mktemp "$state/keyring-password.XXXXXX")
  head -c 32 /dev/urandom | base64 | tr -d '\n' >"$temporary"
  mv -f "$temporary" "$state/keyring-password"
fi
# The keyring files stay in /srv/jargon-hosted, which provision.sh makes for this user. They are
# not in ~/.local/share/keyrings: the boat image has a `default` keyring there with a password that
# this server does not know, and a snapshot restore resets that folder after this service starts.
# They are also not in /home: after a resume, boat serves /home from a slow FUSE mount until the
# disk is restored. There gnome-keyring does not see the new link count after its backup link, so
# each keyring write added links until the mount went away, 16,000 to 31,000 `*.temp-*` files. The
# next resume read that folder through the mount, and the start took 25 s longer. boat keeps
# changes in /srv and restores them before this service starts. libsecret stores in the `default`
# collection, so the alias points to the `login` keyring that the daemon unlocks.
export XDG_DATA_HOME=/srv/jargon-hosted
keyrings="$XDG_DATA_HOME/keyrings"
mkdir -p "$keyrings"
printf login >"$keyrings/default"
# An assignment first, so `set -e` stops the start when the daemon fails. `eval "$(…)"` ignores it.
unlocked=$(gnome-keyring-daemon --unlock --components=secrets <"$state/keyring-password")
eval "$unlocked"
started=$(gnome-keyring-daemon --start --components=secrets)
eval "$started"
unset XDG_DATA_HOME
export GNOME_KEYRING_CONTROL

# If boat ever serves /srv from the FUSE mount too, remove those links when the disk is back. A
# link that is not to the current keyring file is not the backup of a write that is in progress.
(
  for _ in $(seq 1 300); do
    case $(findmnt -n -o FSTYPE -T "$keyrings" || true) in fuse*) sleep 2 ;; *) break ;; esac
  done
  sleep 10
  for keyring in "$keyrings"/*.keyring; do
    [ -e "$keyring" ] || continue
    find "$keyrings" -maxdepth 1 -name "${keyring##*/}.temp-*" ! -samefile "$keyring" -delete
  done
) &

# Jargon and the agents use two displays. Jargon shows its windows on one. The agents work on the
# other, which Jargon names in JARGON_AGENT_DISPLAY: main gives it to Computer Use, to remote
# desktop and to the agent processes, so an agent's screenshot does not show the Jargon window.
#
# The boat desktop is a lightdm session of this user on :0, with a window manager. It is the agent
# display, and Jargon shows its windows on a virtual display. xvfb-run adds the key of that display
# to ~/.Xauthority, which already has the key of :0, so Jargon and the processes it starts can open
# both. lightdm keeps the other keys when it writes the file. After a resume, boat can start the
# session after this service. A sandbox that has no desktop session uses two virtual displays.

# Jargon writes its PID for `--stop` before it starts.
jargon=(bash -c 'echo "$$" >"$XDG_RUNTIME_DIR/jargon.pid" && exec "$@"' jargon-hosted-server
  /opt/Jargon/app/jargon --password-store=gnome-libsecret)
if [ "$mode" = hosted ]; then
  for _ in $(seq 1 60); do
    if DISPLAY=:0 XAUTHORITY="$HOME/.Xauthority" xdpyinfo >/dev/null 2>&1; then
      export JARGON_AGENT_DISPLAY=:0
      exec xvfb-run -a -f "$HOME/.Xauthority" -s "-screen 0 1280x800x24 -nolisten tcp" "${jargon[@]}"
    fi
    sleep 2
  done
  echo "The boat desktop session did not start. Jargon uses two virtual displays." >&2
fi

# The outer xvfb-run starts the agent display, at the display size. The inner one starts the Jargon
# display and adds its key to the same authority file.
exec xvfb-run -a -s "-screen 0 $(display_size "$requested_size")x24 -nolisten tcp" \
  bash -c 'export JARGON_AGENT_DISPLAY=$DISPLAY; exec xvfb-run -a -f "$XAUTHORITY" -s "-screen 0 1280x800x24 -nolisten tcp" "$@"' \
  jargon-hosted-server "${jargon[@]}"
