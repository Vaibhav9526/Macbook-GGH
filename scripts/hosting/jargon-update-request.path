# Jargon asks for an update now with an empty file in its runtime directory. This starts
# jargon-update-request.service as root, which removes the file and never reads it.
[Unit]
Description=Watch for an Jargon update request

[Path]
PathExists=/run/jargon/update-stage
PathExists=/run/jargon/update-install

[Install]
WantedBy=paths.target
